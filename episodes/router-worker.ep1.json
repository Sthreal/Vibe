  "captions": [
    {
      "from": 0,
      "durationInFrames": 140,
      "text": "别急着增加更多 Agent，先看任务是怎么被拆开的。",
      "highlight": "怎么被拆开"
    },
    {
      "from": 140,
      "durationInFrames": 166,
      "text": "系统变慢时，常见原因不是模型不够聪明，而是没人负责收尾。",
      "highlight": "没人负责收尾"
    },
    {
      "from": 306,
      "durationInFrames": 181,
      "text": "加一个新角色之前，先问两句：下一步是谁选的，失败又是谁收的。",
      "highlight": "失败又是谁收的"
    },
    {
      "from": 487,
      "durationInFrames": 169,
      "text": "这一集只讲 Router 怎么调度，Worker 怎么交证据，失败之后怎么停。",
      "highlight": "失败之后怎么停"
    },
    {
      "from": 656,
      "durationInFrames": 196,
      "text": "Super-agent 在这里不是更强的模型，而是会调度、会停、会留下证据的系统。",
      "highlight": "会留下证据"
    },
    {
      "from": 852,
      "durationInFrames": 188,
      "text": "对外可以只有一个入口，对内必须拆成会选择的 Router，和会交付的 Worker。",
      "highlight": "会交付的 Worker"
    },
    {
      "from": 1040,
      "durationInFrames": 224,
      "text": "名字换成编排器或子代理都行。职责不变：一个负责选择，一个负责交付。",
      "highlight": "一个负责选择"
    },
    {
      "from": 1264,
      "durationInFrames": 193,
      "text": "先把这两个角色写窄，再谈记忆和工具。顺序反了，系统就会失控。",
      "highlight": "系统就会失控"
    },
    {
      "from": 1457,
      "durationInFrames": 178,
      "text": "Router 不是大脑，它不负责灵感，只负责在已有选项里选择下一步。",
      "highlight": "选择下一步"
    },
    {
      "from": 1635,
      "durationInFrames": 177,
      "text": "Worker 也不是手脚，它不能只说做完了，还得把可核对的证据交回来。",
      "highlight": "证据交回来"
    },
    {
      "from": 1812,
      "durationInFrames": 174,
      "text": "两边都写成万能助手，边界一旦消失，你就不知道该查哪一层。",
      "highlight": "该查哪一层"
    },
    {
      "from": 1986,
      "durationInFrames": 202,
      "text": "Router 读的是当前状态：目标、已完成步骤、还缺的证据，以及剩余预算。",
      "highlight": "当前状态"
    },
    {
      "from": 2188,
      "durationInFrames": 179,
      "text": "它的输出不是一篇长文，而是一个动作：调用哪个 Worker，或者立刻停止。",
      "highlight": "一个动作"
    },
    {
      "from": 2367,
      "durationInFrames": 223,
      "text": "每次选择都要留下理由。没有理由的路由，事后无法复盘，也没法判断选错没有。",
      "highlight": "留下理由"
    },
    {
      "from": 2590,
      "durationInFrames": 219,
      "text": "Router 不碰工具，也不改写最终答案。它只决定谁来做，以及为什么是现在做。",
      "highlight": "为什么是现在做"
    },
    {
      "from": 2809,
      "durationInFrames": 215,
      "text": "Worker 只看受限上下文。完成本职用得到的材料才放进来，其余一律不给。",
      "highlight": "受限上下文"
    },
    {
      "from": 3024,
      "durationInFrames": 208,
      "text": "一个 Worker 只做一件窄事：检索资料、修改文件、运行测试，或核对某条主张。",
      "highlight": "一件窄事"
    },
    {
      "from": 3232,
      "durationInFrames": 184,
      "text": "交回的结果必须可验收：改了哪几行，退出码是多少，引用了哪一段原文。",
      "highlight": "必须可验收"
    },
    {
      "from": 3416,
      "durationInFrames": 159,
      "text": "如果它只回复已经处理好了，Router 就没有依据进入下一步。",
      "highlight": "没有依据"
    },
    {
      "from": 3575,
      "durationInFrames": 214,
      "text": "工具不是 Worker。工具只提供能力，比如读文件、跑命令，或者查询网页。",
      "highlight": "工具不是 Worker"
    },
    {
      "from": 3789,
      "durationInFrames": 170,
      "text": "由 Worker 决定怎么调用工具，再把回执整理成契约里要求的字段。",
      "highlight": "契约里要求的字段"
    },
    {
      "from": 3959,
      "durationInFrames": 219,
      "text": "超时、没有权限、输出为空，都是回执。不能被模型悄悄说成已经成功。",
      "highlight": "都是回执"
    },
    {
      "from": 4178,
      "durationInFrames": 202,
      "text": "Router 不直接调用工具。它只根据上一轮回执，决定还要不要再派 Worker。",
      "highlight": "不直接调用工具"
    },
    {
      "from": 4380,
      "durationInFrames": 205,
      "text": "Router 和 Worker 之间要有契约。输入、输出和失败码，都要事先写明。",
      "highlight": "事先写明"
    },
    {
      "from": 4585,
      "durationInFrames": 204,
      "text": "契约越窄，系统越稳。缺一个字段，就停在这一步，不要让模型自己补。",
      "highlight": "缺一个字段"
    },
    {
      "from": 4789,
      "durationInFrames": 207,
      "text": "成功和失败使用同一种结构。失败也是结果，它表示这一步没有新证据。",
      "highlight": "没有新证据"
    },
    {
      "from": 4996,
      "durationInFrames": 184,
      "text": "于是日志可以对账：发出去的任务，收回来的证据，两边到底对不对得上。",
      "highlight": "可以对账"
    },
    {
      "from": 5180,
      "durationInFrames": 252,
      "text": "Router 不该自己写最终答案。它一旦又选又做，失败时就分不清是决策错还是执行错。",
      "highlight": "不该自己写最终答案"
    },
    {
      "from": 5432,
      "durationInFrames": 223,
      "text": "Router 不该读到全部工具的原始输出。摘要和状态就够了，原文留给对应的 Worker。",
      "highlight": "原始输出"
    },
    {
      "from": 5655,
      "durationInFrames": 230,
      "text": "不要把上一轮失败藏起来。下一轮的输入里必须看得到错误，否则它会重复同一次选择。",
      "highlight": "必须看得到错误"
    },
    {
      "from": 5885,
      "durationInFrames": 190,
      "text": "也不要在提示词里写“无论如何都要给出答案”。系统必须被允许停下来。",
      "highlight": "被允许停下来"
    },
    {
      "from": 6075,
      "durationInFrames": 217,
      "text": "能自愈的系统，把一轮工作写成状态机：计划、执行、观察，然后再决策。",
      "highlight": "状态机"
    },
    {
      "from": 6292,
      "durationInFrames": 196,
      "text": "计划阶段只产生下一步，不产生最终答案，避免一边思考一边改外部世界。",
      "highlight": "只产生下一步"
    },
    {
      "from": 6488,
      "durationInFrames": 192,
      "text": "观察阶段读取回执：文件变了没有，测试绿了没有，状态到底有没有前进。",
      "highlight": "有没有前进"
    },
    {
      "from": 6680,
      "durationInFrames": 221,
      "text": "状态没有前进，就不能装成进入了下一轮。先记下原因，再决定重试还是停。",
      "highlight": "先记下原因"
    },
    {
      "from": 6901,
      "durationInFrames": 221,
      "text": "重试如果没有新证据，就只是在消耗预算。同一份报错，再跑十次也不会变好。",
      "highlight": "消耗预算"
    },
    {
      "from": 7122,
      "durationInFrames": 203,
      "text": "给每一轮写上预算：最多几次重试，多少次工具调用，以及多长的墙钟时间。",
      "highlight": "写上预算"
    },
    {
      "from": 7325,
      "durationInFrames": 201,
      "text": "预算一旦耗尽，状态机进入失败终态，而不是再向模型要一句更乐观的话。",
      "highlight": "失败终态"
    },
    {
      "from": 7526,
      "durationInFrames": 175,
      "text": "封顶不是消极。它把无限循环变成一次可以被解释的停止。",
      "highlight": "可以被解释的停止"
    },
    {
      "from": 7701,
      "durationInFrames": 212,
      "text": "有三类情况应该升级给人：模型不确定，工具没有权限，证据之间互相矛盾。",
      "highlight": "升级给人"
    },
    {
      "from": 7913,
      "durationInFrames": 230,
      "text": "升级时要带上上下文：当前目标，试过的路径，最后一条错误，以及希望人做的决定。",
      "highlight": "带上上下文"
    },
    {
      "from": 8143,
      "durationInFrames": 234,
      "text": "人做出的决定要写回状态。下一轮 Router 看到的是事实，不是一段被丢掉的聊天。",
      "highlight": "写回状态"
    },
    {
      "from": 8377,
      "durationInFrames": 179,
      "text": "升级不是失败。该停的时候继续采样，才会把错误越写越深。",
      "highlight": "不是失败"
    },
    {
      "from": 8556,
      "durationInFrames": 213,
      "text": "Debug 的时候先看轨迹，不要先怪模型。很多故障是交接断了，不是文笔不好。",
      "highlight": "先看轨迹"
    },
    {
      "from": 8769,
      "durationInFrames": 208,
      "text": "顺着三条线往下读：路由当时看到的输入，Worker 交回的产出，工具返回的回执。",
      "highlight": "三条线"
    },
    {
      "from": 8977,
      "durationInFrames": 227,
      "text": "输入缺了字段，这次调用就不该发出。工具超时，就是执行层没有在预算内返回。",
      "highlight": "输入缺了字段"
    },
    {
      "from": 9204,
      "durationInFrames": 222,
      "text": "结果无法验证，就是 Worker 没有按契约交出证据。这三件事的修法完全不同。",
      "highlight": "修法完全不同"
    },
    {
      "from": 9426,
      "durationInFrames": 201,
      "text": "举一个具体的例子。任务是修复失败的测试，Router 把改代码交给 Worker。",
      "highlight": "失败的测试"
    },
    {
      "from": 9627,
      "durationInFrames": 207,
      "text": "Worker 改完了文件，测试却仍然是红的。动作已经发生，状态却没有前进。",
      "highlight": "没有前进"
    },
    {
      "from": 9834,
      "durationInFrames": 215,
      "text": "如果下一次拿到的还是同一份报错，就不要改提示词碰运气，把这条轨迹升级给人。",
      "highlight": "同一份报错"
    },
    {
      "from": 10049,
      "durationInFrames": 205,
      "text": "人指出真正该改的断言之后，新证据写回状态，Router 才能合法地再派一轮。",
      "highlight": "新证据写回状态"
    },
    {
      "from": 10254,
      "durationInFrames": 219,
      "text": "自动执行一定要能撤回。改过的文件，发出的请求，都要知道怎么回到上一步。",
      "highlight": "能撤回"
    },
    {
      "from": 10473,
      "durationInFrames": 235,
      "text": "没有回滚点的 Worker，不应该拿到写权限。只读的核对可以大胆做，写入必须小步提交。",
      "highlight": "小步提交"
    },
    {
      "from": 10708,
      "durationInFrames": 229,
      "text": "每次写入都对应一个可以撤销的检查点。做不到这一点，就不要让它自动连续执行。",
      "highlight": "可以撤销的检查点"
    },
    {
      "from": 10937,
      "durationInFrames": 209,
      "text": "可追溯，可验收，可回滚。缺了任何一件，它就还只是一组会说话的脚本。",
      "highlight": "可回滚"
    },
    {
      "from": 11146,
      "durationInFrames": 194,
      "text": "落地时先写一张表：有哪些 Worker，每个的输入、输出和失败码分别是什么。",
      "highlight": "先写一张表"
    },
    {
      "from": 11340,
      "durationInFrames": 190,
      "text": "再写状态机有哪些状态，哪些边允许重试，哪些边必须升级给人。",
      "highlight": "哪些边允许重试"
