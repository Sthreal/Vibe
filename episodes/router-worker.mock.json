    {
      "from": 270,
      "durationInFrames": 180,
      "text": "Worker 也不是手脚，它要带着证据交回结果。",
      "highlight": "带着证据"
    },
    {
      "from": 450,
      "durationInFrames": 180,
      "text": "拆任务、执行、验收，每一步都必须有明确边界。",
